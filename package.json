{
  "name": "hanzanhae",
  "version": "1.0.0",
  "description": "물을 마시며 나만의 정원을 가꾸는 데스크톱 앱",
  "main": "./out/main/index.js",
  "author": "Heo-zip",
  "homepage": "https://github.com/Heo-zip/hanzanhae",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test:storage": "node --test tests/storage.test.mjs tests/drink-count.test.mjs",
    "test:camera": "node --test tests/camera-detection.test.mjs tests/camera-security.test.mjs",
    "test:position": "node --test tests/garden-position.test.mjs",
    "test:reminders": "node --test tests/reminder-policy.test.mjs tests/reminder-service.test.mjs",
    "test:update": "node --test tests/auto-update.test.mjs",
    "test:platform": "node --test tests/platform.test.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/run-dev.mjs",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:unpack:mac:local": "npm run build && electron-builder --dir --mac --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "build:mac:unsigned": "npm run build && electron-builder --mac --arm64 --publish never --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "build:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "build:unpack:win": "npm run build && electron-builder --dir --win --x64",
    "build:unpack:linux": "npm run build && electron-builder --dir --linux --x64",
    "check:mac:bundle": "node scripts/check-mac-bundle.mjs",
    "perf:animations": "node scripts/perf/animations.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
